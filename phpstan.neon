includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

    # Read model casts from the body of casts() instead of its `array` return type
    parseModelCastsMethod: true

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
